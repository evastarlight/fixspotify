{
  "name": "fixspotify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite build --mode development --watch\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/node": "^22.5.3",
    "colorthief": "^2.6.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.126.0"
  }
}
